# Example environment variables for iptv_proxy
XMLTV_URL=http://your-xmltv-server/api/mdb/xmltv?lang=hu
PROVIDER_URL=https://your-provider-url
JACKETT_HOST=http://your-jackett-host:9117
JACKETT_API_KEY=your-jackett-api-key
PREFERRED_LANGUAGE=hun

# Optional HDHomeRun tuner emulation settings
HDHR_FRIENDLY_NAME=IPTV Proxy
HDHR_TUNER_COUNT=4
#HDHR_DEVICE_ID=1234ABCD
#HDHR_BASE_URL=http://192.168.1.10:8045
